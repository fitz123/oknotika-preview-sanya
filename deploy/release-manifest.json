{
  "schemaVersion": 1,
  "runtime": {
    "nodeMajor": 24,
    "nodeVersion": "24.18.0",
    "nodeReleaseLine": "Krypton LTS",
    "nodeInstallRoot": "/opt/node-v24.18.0",
    "sqliteProvider": "node:sqlite",
    "sqliteVersion": "3.53.1",
    "packageLockVersion": 3,
    "packageLockSha256": "79ef43e16c4902d3fdb22e38f4e6ccee9e75c24f88451d3743272fc7b4d1f4d5"
  },
  "layout": {
    "applicationReleases": "/opt/oknotika-admin/releases/<sha>",
    "applicationCurrent": "/opt/oknotika-admin/current",
    "database": "/var/lib/oknotika-admin/db/admin.sqlite",
    "uploads": "/var/lib/oknotika-admin/uploads",
    "previews": "/var/lib/oknotika-admin/previews",
    "articleReleases": "/var/lib/oknotika-admin/article-releases",
    "socket": "/run/oknotika-admin/app.sock",
    "serviceUser": "oknotika-admin",
    "serviceGroup": "www-data",
    "socketMode": "0660"
  },
  "dependencyPolicy": {
    "application": "admin-app/package-lock.json is authoritative and npm ci is mandatory",
    "sqlite": "SQLite is bundled with the exact Node.js patch and verified by preflight"
  },
  "editorial": {
    "publicSection": {
      "name": "Новости",
      "path": "/articles/",
      "weeklyMaterialLabel": "Дайджест недели"
    },
    "weeklySchedule": {
      "draftCreation": "Tuesday 12:00 Europe/Moscow",
      "publicationTarget": "Friday 18:00 Europe/Moscow",
      "publicationAuthority": "telegram-oidc-editor-only"
    },
    "weeklyIngestion": {
      "path": "/api/ingestion/weekly-drafts",
      "method": "POST",
      "maximumBodyBytes": 131072,
      "credential": "weekly-ingest-token",
      "authority": "create-or-update-private-weekly-draft-only",
      "idempotency": "issueId plus monotonic contentVersion"
    },
    "socialDestinations": {
      "telegram": "https://t.me/oknotika",
      "youtube": "https://youtube.com/@oknotika",
      "vk": "https://vk.ru/oknotika",
      "futuchat": "https://t.me/FUTU_CHAT",
      "configuration": "confirmed editor action atomically activates validated values in a new immutable article release; null destinations are not rendered"
    }
  },
  "credentials": {
    "provider": "systemd LoadCredentialEncrypted",
    "adminService": [
      "telegram-oidc-client-id",
      "telegram-oidc-client-secret",
      "weekly-ingest-token"
    ],
    "weeklyCaller": [
      "weekly-ingest-token"
    ],
    "backupService": [
      "restic-repository",
      "restic-password"
    ],
    "environmentValuesForbidden": true
  },
  "packageBoundaries": {
    "marketing": "deploy/scripts/install-marketing.sh public_paths allowlist only",
    "technical": "secret-free release ZIP outside every nginx document root",
    "privateRuntime": "/var/lib/oknotika-admin and /run/credentials; never packaged or public"
  },
  "backup": {
    "engine": "restic",
    "retention": {
      "daily": 7,
      "weekly": 8,
      "monthly": 12
    },
    "rpoHours": 24,
    "rtoHours": 2,
    "afterPublishTrigger": "oknotika-admin-backup.path"
  }
}
