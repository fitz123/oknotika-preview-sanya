# Non-secret sample only. Production secrets are mounted as protected credential files.
# Local username and password hash are accepted only through *_FILE settings.
OKNOTIKA_ADMIN_ORIGIN=https://admin.oknotika.ru
OKNOTIKA_PUBLIC_ORIGIN=https://oknotika.ru
OKNOTIKA_LOCAL_USERNAME_FILE=/run/credentials/oknotika-admin.service/local-username
OKNOTIKA_LOCAL_PASSWORD_HASH_FILE=/run/credentials/oknotika-admin.service/local-password-hash
OKNOTIKA_WEEKLY_INGEST_TOKEN_FILE=/run/credentials/oknotika-admin.service/weekly-ingest-token

OKNOTIKA_DATABASE_PATH=/var/lib/oknotika-admin/db/admin.sqlite
OKNOTIKA_UPLOADS_ROOT=/var/lib/oknotika-admin/uploads
OKNOTIKA_PREVIEWS_ROOT=/var/lib/oknotika-admin/previews
OKNOTIKA_ARTICLE_RELEASES_ROOT=/var/lib/oknotika-admin/article-releases
OKNOTIKA_PUBLIC_ROOT=/srv/oknotika/current
# Unix mode is the default and remains the systemd deployment mode.
# For container TCP mode, omit OKNOTIKA_LISTEN_SOCKET and set both
# OKNOTIKA_LISTEN_HOST and OKNOTIKA_LISTEN_PORT explicitly.
OKNOTIKA_LISTEN_SOCKET=/run/oknotika-admin/app.sock

# Social destinations are schema-seeded non-secret content, not environment values:
# https://t.me/oknotika, https://youtube.com/@oknotika,
# https://vk.ru/oknotika, https://t.me/FUTU_CHAT
